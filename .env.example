# ------------------------------------------------------------------------------
# Barabanki Connect — Production & Staging Environment Configuration Template
# Copy this file to .env and configure values before starting the application
# ------------------------------------------------------------------------------

# Application Environment
PROJECT_NAME="Barabanki Connect"
PROJECT_TAGLINE="Empowering Citizens, Students, Businesses & Heritage in Barabanki"
ENVIRONMENT="production"            # Options: development | staging | production | test
DEBUG=False                         # NEVER enable in production
HOST="0.0.0.0"
PORT=8000

# Security Credentials
# Generate 32-byte keys with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY="replace_with_a_secure_random_32_byte_secret_key"
CSRF_SECRET="replace_with_a_secure_random_csrf_signing_key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440     # 24 Hours
SESSION_COOKIE_NAME="barabanki_session"
COOKIE_SECURE=True                   # Enforce HTTPS-only cookies in production

# Cross-Origin Resource Sharing (CORS)
# JSON-encoded array or comma-separated list of allowed origins
ALLOWED_ORIGINS='["https://barabanki-connect.onrender.com", "https://barabanki.up.gov.in", "https://barabanki-connect.in", "http://localhost:8000"]'

# Rate Limiting & Protection
RATE_LIMIT_ENABLED=True
RATE_LIMIT_AUTH_PER_MINUTE=20        # Throttles login & registration attempts
RATE_LIMIT_SUBMIT_PER_MINUTE=40      # Throttles form and resource creation
STATIC_CACHE_MAX_AGE=86400           # 24 Hours browser caching for static assets

# Database Configuration
# 1. Local SQLite (development only):
# DATABASE_URL="sqlite:///./barabanki.db"
#
# 2. Neon Managed PostgreSQL (Production — replace with your actual Neon connection string):
# Neon connection pooling URL format (recommended for serverless compute):
DATABASE_URL="postgresql+psycopg2://neondb_owner:YOUR_NEON_PASSWORD@ep-cool-base-123456-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Media Storage Configuration
STORAGE_BACKEND="url"                # Options: url (default, zero ephemeral storage risk) | s3 | cloudinary
# Optional Object Storage (if STORAGE_BACKEND="s3", e.g. Cloudflare R2 / AWS S3):
# STORAGE_BUCKET="barabanki-media"
# STORAGE_ENDPOINT_URL="https://<account_id>.r2.cloudflarestorage.com"
# STORAGE_ACCESS_KEY_ID="your_access_key"
# STORAGE_SECRET_ACCESS_KEY="your_secret_key"
# STORAGE_PUBLIC_BASE_URL="https://media.barabanki-connect.in"

# Initial Superadmin Credentials (only seeded on clean database bootstrap)
ADMIN_EMAIL="admin@barabanki.local"
ADMIN_PASSWORD="ReplaceWithAStrongAdminPassword123!"

# Pagination & Catalog View Sizes
DEFAULT_PAGE_SIZE=12
