# -------------------------------------------------------------
# Barabanki Connect — Environment Configuration Template
# Copy this file to .env and adjust values for your environment
# -------------------------------------------------------------

# Application
PROJECT_NAME="Barabanki Connect"
ENVIRONMENT="development"
DEBUG=True
HOST="0.0.0.0"
PORT=8000

# Security (Generate a secure key with: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY="change_this_to_a_random_32_byte_secret_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SESSION_COOKIE_NAME="barabanki_session"

# Database Configuration
# For local SQLite development (default fallback):
DATABASE_URL="sqlite:///./barabanki.db"

# For PostgreSQL production / local PostgreSQL 18:
# DATABASE_URL="postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/barabanki_db"

# Initial Superadmin Credentials (for seeding)
ADMIN_EMAIL="admin@barabanki.local"
ADMIN_PASSWORD="Admin@123456"

# Pagination
DEFAULT_PAGE_SIZE=12
